#!/usr/bin/env bash
#MISE description="Merge the upstream tag, or open a conflict issue and fail"
set -euo pipefail
git config user.name 'github-actions[bot]'
git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
if git merge --no-ff --no-edit -m "chore(sync): merge upstream $TAG" "refs/tags/$TAG"; then
  echo "conflict=false" >> "$GITHUB_OUTPUT"
  exit 0
fi
echo "conflict=true" >> "$GITHUB_OUTPUT"
git diff --name-only --diff-filter=U > "$RUNNER_TEMP/conflicts.txt"
git merge --abort
title="Upstream sync conflict: $TAG"
{
  echo "Merging upstream $TAG into main hit conflicts."
  echo
  echo "Conflicting files:"
  sed 's/^/- /' "$RUNNER_TEMP/conflicts.txt"
  echo
  echo "Run: $RUN_URL"
  echo
  echo "Resolve locally with: git merge $TAG, then push the result to main."
} > "$RUNNER_TEMP/conflict-body.txt"
# gh under GITHUB_TOKEN is non-interactive: pass the body by file so no
# editor or prompt is needed, and skip labels that may not exist.
existing="$(gh issue list --state open --limit 200 --json number,title \
  --jq "[.[] | select(.title == \"$title\")] | length")"
if [ "$existing" = "0" ]; then
  gh issue create --title "$title" --body-file "$RUNNER_TEMP/conflict-body.txt"
else
  echo "Open conflict issue already exists"
fi
exit 1
