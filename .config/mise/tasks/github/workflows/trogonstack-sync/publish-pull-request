#!/usr/bin/env bash
#MISE description="Publish a merge that fails verification as a pull request and fail"
set -euo pipefail
branch="sync/$TAG"
git fetch origin "$branch" || true
git push --force-with-lease origin "HEAD:refs/heads/$branch"
title="chore(sync): merge upstream $TAG"
{
  echo "Merging upstream $TAG into main is clean but build or tests failed."
  echo
  echo "Failed run: $RUN_URL"
  echo
  echo "Fix on this branch, then merge it into main."
} > "$RUNNER_TEMP/pr-body.txt"
existing="$(gh pr list --state open --head "$branch" --json number --jq 'length')"
if [ "$existing" = "0" ]; then
  gh pr create --base main --head "$branch" --title "$title" \
    --body-file "$RUNNER_TEMP/pr-body.txt"
else
  echo "Open sync PR already exists"
fi
exit 1
