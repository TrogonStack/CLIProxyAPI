#!/usr/bin/env bash
#MISE description="Publish a merge that cannot land on main as a draft pull request and fail"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.config/mise/lib/git.sh"

branch="sync/$TAG"
# An open pull request may already carry fixes, so leave its branch alone.
existing="$(gh pr list --state open --head "$branch" --json url --jq '.[0].url // ""')"
if [ -n "$existing" ]; then
  echo "Upstream $TAG is still pending on $existing" >> "$GITHUB_STEP_SUMMARY"
  exit 1
fi

# Pushed as Barnacle so the pull request runs CI and may change workflows.
# Without an open pull request the branch is stale, so it is replaced.
git_push_as "$BARNACLE_TOKEN" --force origin "HEAD:refs/heads/$branch"

{
  echo "Merging upstream $TAG into main needs a fix before it can land: $REASON"
  if [ -s "$RUNNER_TEMP/conflicts.txt" ]; then
    echo
    echo "Conflicting files, committed with their markers:"
    sed 's/^/- /' "$RUNNER_TEMP/conflicts.txt"
  fi
  echo
  echo "Run: $RUN_URL"
  echo
  echo "Fix on this branch, mark it ready, then merge it into main."
} > "$RUNNER_TEMP/pr-body.txt"
url="$(GH_TOKEN="$BARNACLE_TOKEN" gh pr create --draft --base main --head "$branch" \
  --title "chore(sync): merge upstream $TAG" --body-file "$RUNNER_TEMP/pr-body.txt")"
echo "Upstream $TAG is pending on $url" >> "$GITHUB_STEP_SUMMARY"
exit 1
